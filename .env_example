# one ethereum-style private key signs for ALL six subaccounts (Moon Dev)
HYPERLIQUID_PRIVATE_KEY=

# hyperliquid subaccount ADDRESSES, in fighter order:
# ACCT1=CLAUDE  ACCT2=OPENAI  ACCT3=GEMINI  ACCT4=GROK  ACCT5=KIMI  ACCT6=DEEPSEEK
ACCT1=
ACCT2=
ACCT3=
ACCT4=
ACCT5=
ACCT6=

# moon dev api for extra data
MOONDEV_API_KEY=

# openrouter - one key for all 6 battle models (openrouter.ai)
OPENROUTER_API_KEY=

# decision push -> moon dev api server (feeds moondev.com/ai)
# leave blank to skip pushing (e.g. dry runs). key is a shared secret,
# generate with: openssl rand -hex 32 (same value goes on the api server)
BATTLE_PUSH_URL=
BATTLE_PUSH_KEY=

# 💓 heartbeat push -> moon dev api server (OUTBOUND ONLY, no inbound port on
# the battle box). set on the SERVER running run_battle.py. blank = local
# data/heartbeat.json only. uses the same BATTLE_PUSH_KEY secret.
BATTLE_HEARTBEAT_URL=

# 📡 watchtower (watch_battle.py on the mac) - where it READS the heartbeat.
# blank = watch the local data/heartbeat.json on this same machine
WATCH_HEARTBEAT_URL=
